# Set automatically by the Vercel + Neon integration.
# For local dev, copy the pooled connection string from the Neon dashboard.
DATABASE_URL=

# Optional. Defaults to Australia/Sydney.
TZ_NAME=Australia/Sydney

# One-time bootstrap token — claims the first adult identity via /pair.
# Generate any long random string yourself (e.g. `openssl rand -hex 24`).
# Inert forever once used; see docs/identity.md.
SETUP_TOKEN=

# Anthropic API key — powers lib/ingest/bulletin.js (extraction) and the
# planned Q&A route. Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Gmail ingestion — dedicated mailbox, IMAP with an App Password (needs 2FA
# enabled on the account first). See docs/ingestion.md.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
